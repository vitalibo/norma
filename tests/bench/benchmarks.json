[
  {
    "benchmark": "flat",
    "description": "cols top level string columns",
    "runs": [
      "cols=2,schema=true,analyzed_plan=true,physical_plan=true",
      "cols=4",
      "cols=8",
      "cols=16",
      "cols=32",
      "cols=128,rows=1000000"
    ],
    "state": {
      "data": {
        "!iter(row in 0..{rows})": [
          {
            "!for(i in 0..{cols})": {
              "f{i}": "(row + {i}) % 110 - 5"
            }
          }
        ]
      },
      "schema": {
        "type": "struct",
        "fields": {
          "!for(i in 0..{cols})": [
            {
              "name": "f{i}",
              "type": "string"
            }
          ]
        }
      }
    },
    "json_schema": {
      "type": "object",
      "properties": {
        "!for(i in 0..{cols})": {
          "f{i}": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "multipleOf": 2
          }
        }
      }
    }
  },
